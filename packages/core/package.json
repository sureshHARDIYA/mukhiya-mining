{
  "name": "@pathminer/core",
  "version": "0.1.3",
  "description": "Framework-free process-mining core: event-log indexing, filters, directly-follows graphs, variants, statistics and layout.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshHARDIYA/pathminer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sureshHARDIYA/pathminer#readme",
  "bugs": "https://github.com/sureshHARDIYA/pathminer/issues",
  "keywords": [
    "process-mining",
    "event-log",
    "directly-follows-graph",
    "react",
    "typescript",
    "clickstream",
    "analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
