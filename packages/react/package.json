{
  "name": "@mukhiya-mining/react",
  "version": "0.1.0",
  "description": "React components for exploring process event logs: process map, statistics, cases and filters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshHARDIYA/mukhiya-mining.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/sureshHARDIYA/mukhiya-mining#readme",
  "bugs": "https://github.com/sureshHARDIYA/mukhiya-mining/issues",
  "keywords": [
    "process-mining",
    "event-log",
    "directly-follows-graph",
    "react",
    "typescript",
    "clickstream",
    "analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --external react,react-dom && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@mukhiya-mining/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
