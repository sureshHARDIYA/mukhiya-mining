{
  "name": "mukhiya-mining-workspace",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --filter demo dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
